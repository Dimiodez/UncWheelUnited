{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unc-futbol-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {"binding":"BROWSER"},
  "assets": {"directory":"assets/stat-backgrounds","binding":"ASSETS","run_worker_first":true},
  "observability": {"enabled":true,"head_sampling_rate":1},
  "triggers": {"crons":["* * * * *"]},
  "vars": {
    "ENVIRONMENT": "production",
    "EA_MATCHES_ENABLED": "true",
    "EA_API_BASE_URL": "https://proclubs-api.onrender.com/api"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unc-futbol-bot",
      "database_id": "9882207f-a8b0-4be9-a387-bd3c04a53500",
      "migrations_dir": "migrations"
    }
  ]
}
